---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArrowIcon from '../components/ArrowIcon.astro';
---
<BaseLayout title="Page not found">
  <section class="final-cta" style="padding: 200px 32px 160px;">
    <span class="eyebrow" style="display:block; margin-bottom: 28px;">404</span>
    <h2 class="display">
      This page is <em>still being built</em>.
    </h2>
    <p>
      We're writing this part of the site. In the meantime, the home page is
      the best place to get a feel for who we are.
    </p>
    <a href="/" class="btn-primary">
      Back home
      <ArrowIcon />
    </a>
  </section>
</BaseLayout>
