---
// Site-wide footer. Links match the planned site structure.
const year = new Date().getFullYear();
---
<footer>
  <div class="footer-inner">
    <div class="footer-brand">
      <div class="logo">
        <span class="logo-mark"></span>
        Alexandra<em class="logo-tail">'s</em>
      </div>
      <p>
        A Melbourne childcare centre built on play-led inquiry and intentional
        structure. EYLF-aligned and NQF-approved.
      </p>
    </div>
    <div class="footer-col">
      <h5>Explore</h5>
      <ul>
        <li><a href="/our-story">Our Story</a></li>
        <li><a href="/philosophy">Philosophy</a></li>
        <li><a href="/curriculum">Curriculum</a></li>
        <li><a href="/daily-life">A Day Here</a></li>
        <li><a href="/environments">Environments</a></li>
        <li><a href="/team">Team</a></li>
      </ul>
    </div>
    <div class="footer-col">
      <h5>Parents</h5>
      <ul>
        <li><a href="/book-a-tour">Book a Tour</a></li>
        <li><a href="/parent-partnerships">Parent Partnership</a></li>
        <li><a href="/resources">Resources</a></li>
        <li><a href="/practical-info">Fees &amp; Practical Info</a></li>
      </ul>
    </div>
    <div class="footer-col">
      <h5>Visit</h5>
      <ul>
        <li><span>Inner Melbourne</span></li>
        <li><span>(03) 0000 0000</span></li>
        <li><a href="mailto:hello@alexandral.com.au">hello@alexandral.com.au</a></li>
      </ul>
    </div>
  </div>
  <div class="footer-bottom">
    <span>© {year} Alexandra's Childcare Centre</span>
    <span>Privacy · Terms</span>
  </div>
</footer>
